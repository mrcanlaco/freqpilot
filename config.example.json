{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "FreqPilot paper",
  "dry_run": true,
  "initial_state": "stopped",
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "stake_currency": "USDT",
  "stake_amount": 100,
  "dry_run_wallet": 1000,
  "tradable_balance_ratio": 0.95,
  "max_open_trades": 2,
  "timeframe": "15m",
  "fee": 0.0005,
  "force_entry_enable": false,
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "jsongz",
  "unfilledtimeout": { "entry": 10, "exit": 10, "exit_timeout_count": 0, "unit": "minutes" },
  "entry_pricing": { "price_side": "other", "use_order_book": true, "order_book_top": 1 },
  "exit_pricing": { "price_side": "other", "use_order_book": true, "order_book_top": 1 },
  "exchange": {
    "name": "binance", "key": "", "secret": "",
    "pair_whitelist": ["BTC/USDT:USDT", "ETH/USDT:USDT"], "pair_blacklist": []
  },
  "pairlists": [{ "method": "StaticPairList" }],
  "api_server": {
    "enabled": true, "listen_ip_address": "0.0.0.0", "listen_port": 8080,
    "verbosity": "error", "enable_openapi": false,
    "username": "freqpilot", "password": "__GENERATE__",
    "jwt_secret_key": "__GENERATE__", "ws_token": "__GENERATE__",
    "CORS_origins": ["http://localhost:8090", "http://localhost:8091", "http://localhost:8095", "http://127.0.0.1:8090", "http://127.0.0.1:8091", "http://127.0.0.1:8095"]
  },
  "telegram": { "enabled": false, "token": "", "chat_id": "" },
  "internals": { "process_throttle_secs": 5 }
}
